{
	"mcpServers": {
		"sonarqube-mcp": {
			"type": "stdio",
			"command": "docker",
			"args": [
				"run",
				"--init",
				"--pull=always",
				"-i",
				"--rm",
				"-e",
				"SONARQUBE_TOKEN",
				"-e",
				"SONARQUBE_ORG",
				"-e",
				"SONARQUBE_URL",
				"sonarsource/sonarqube-mcp"
			],
			"tools": [
				"*"
			]
		}
	}
}
